# Copy to .env for local dev and .env.test for the test databases.

# Postgres connection for the running app (raw SQL, no ORM).
DATABASE_URL=postgres://postgres@localhost:5432/homemate

# HMAC secret used to sign/verify session tokens (src/shared/session-tokens.mjs).
# Generate a real one for anything beyond local dev: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_TOKEN_SECRET=dev-secret-change-me

# Which NotificationPort adapter to wire up (Section 2.1 of IMPLEMENTATION_PLAN.md).
# "sandbox" is the only adapter implemented so far — never send real SMS in dev/test.
NOTIFICATION_PROVIDER=sandbox

# Predefined admin credentials (src/services/admin-access) — the single
# bootstrap administrator for the backoffice portal. No DB row, no OTP.
# Change these for anything beyond local dev.
ADMIN_EMAIL=admin@homemate.co.tz
ADMIN_PASSWORD=change-me-please

PORT=3001

# StoragePort: "memory" (default, no service needed) or "zebra" (smartstock-storage).
STORAGE_PROVIDER=memory
# STORAGE_BASE_URL=https://zebra.storage.example
# STORAGE_USERNAME=homemate
# STORAGE_PASSWORD=change-me

# The Google Play review account. A reviewer has no Tanzanian SIM, so this one
# number gets a fixed code that is never sent by SMS; everything else about the
# account is ordinary. Set BOTH or NEITHER. Leave unset outside production, and
# rotate the code after each review.
# REVIEW_ACCOUNT_PHONE=+255700000000
# REVIEW_ACCOUNT_OTP=246810

# SMS for OTPs: "sandbox" (default; codes stay in memory and can be read back
# from GET /customer/auth/otp/last) or "nextsms". Any real deployment sets
# nextsms, which also switches that dev route off.
# SMS_PROVIDER=nextsms
# SMS_USERNAME=
# SMS_PASSWORD=
# SMS_SENDER_ID=HOMEMATE
# SMS_TEST_MODE=false

# Behind a load balancer, trust X-Forwarded-For for the per-IP OTP limits.
# TRUST_PROXY=true

# Base of the public links partners share for their listings.
# PUBLIC_WEB_URL=https://homemate.co.tz

# The server migrates its database on start; set false to run migrations as a
# separate release step instead.
# AUTO_MIGRATE=false
